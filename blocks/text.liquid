{% liquid
  assign tag = block.settings.tag
%}

{% if tag == 'h1' %}
  <h1 class="text-block {{ block.settings.custom_class }}">
    {{ block.settings.text }}
  </h1>

{% elsif tag == 'h2' %}
  <h2 class="text-block {{ block.settings.custom_class }}">
    {{ block.settings.text }}
  </h2>

{% elsif tag == 'h3' %}
  <h3 class="text-block {{ block.settings.custom_class }}">
    {{ block.settings.text }}
  </h3>

{% elsif tag == 'p' %}
  <p class="text-block {{ block.settings.custom_class }}">
    {{ block.settings.text }}
  </p>

{% elsif tag == 'span' %}
  <span class="text-block {{ block.settings.custom_class }}">
    {{ block.settings.text }}
  </span>

{% else %}
  <div class="text-block {{ block.settings.custom_class }}">
    {{ block.settings.text }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Text Block",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Your text here"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "HTML Element",
      "default": "p",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "p", "label": "Paragraph" },
        { "value": "span", "label": "Span" },
        { "value": "div", "label": "Div" }
      ]
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Text Block"
    }
  ]
}
{% endschema %}
