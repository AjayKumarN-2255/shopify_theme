<div class="group-block {{ block.settings.custom_class }}">
  {% if block.settings.heading != blank %}
    <h3 class="group-heading">
      {{ block.settings.heading }}
    </h3>
  {% endif %}

  <div class="group-content">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Group",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Group Title"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Group"
    }
  ]
}
{% endschema %}
