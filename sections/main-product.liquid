{% assign all_images = product.images | slice: 0, section.settings.image_count %}
{% assign first_image = all_images | first %}
{% assign extra_images = all_images | slice: 1, all_images.size %}

<div class="sp-wrap">
  {% comment %} Pass 1 — render main_image + details inside the shared sp-inner grid {% endcomment %}
  {% assign has_main = false %}
  {% assign has_detail = false %}
  {% for block in section.blocks %}
    {% if block.type == 'main_image' %}{% assign has_main = true %}{% endif %}
    {% if block.type == 'details' %}{% assign has_detail = true %}{% endif %}
  {% endfor %}

  {% if has_main or has_detail %}
    <div class="sp-inner">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'main_image' %}
            <div class="sp-gallery" {{ block.shopify_attributes }}>
              <div class="sp-img-frame">
                <img
                  src="{{ first_image | image_url: width: 900 }}"
                  alt="{{ first_image.alt | escape }}"
                  width="900"
                  height="900"
                  loading="eager"
                >
                <div class="sp-img-shine"></div>
              </div>
            </div>

          {% when 'details' %}
            <div class="sp-details" {{ block.shopify_attributes }}>
              <div class="sp-details-inner">
                <div class="sp-eyebrow">
                  <span class="sp-tag">{{ product.type }}</span>
                  <span class="sp-divider-dot"></span>
                  <span class="sp-sku">
                    {%- if product.selected_or_first_available_variant.sku != blank -%}
                      SKU: {{ product.selected_or_first_available_variant.sku -}}
                    {%- endif -%}
                  </span>
                </div>

                <h1 class="sp-title">{{ product.title }}</h1>

                {% assign current_variant = product.selected_or_first_available_variant %}

                {% for option in product.options_with_values %}
                  <div class="variant-group">
                    <label class="variant-label">{{ option.name }}</label>

                    <div class="variant-values">
                      {% for value in option.values %}
                        {% assign option_index = forloop.parentloop.index0 %}

                        <button
                          type="button"
                          class="variant-btn {% if current_variant.options[option_index] == value %}selected{% endif %}"
                        >
                          {{ value }}
                        </button>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}

                <div class="sp-price-row">
                  {% if product.compare_at_price > product.price %}
                    <span class="sp-price sp-price--sale">{{ product.price | money }}</span>
                    <span class="sp-price sp-price--compare">{{ product.compare_at_price | money }}</span>
                    <span class="sp-badge">Sale</span>
                  {% else %}
                    <span class="sp-price">{{ product.price | money }}</span>
                  {% endif %}
                </div>

                <div class="sp-rule"></div>

                {% if section.settings.show_description and product.description != blank %}
                  <div class="sp-description">
                    {{ product.description }}
                  </div>
                {% endif %}

                {% form 'product', product, class: 'sp-form' %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <div class="sp-actions">
                    <button type="submit" class="sp-btn-cart">
                      <span class="sp-btn-cart-text">{{ section.settings.button_text }}</span>
                      <span class="sp-btn-cart-icon">
                        <svg
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                        >
                          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                          <line x1="3" y1="6" x2="21" y2="6"/>
                          <path d="M16 10a4 4 0 01-8 0"/>
                        </svg>
                      </span>
                    </button>
                  </div>
                {% endform %}

                <div class="sp-meta">
                  {% if product.vendor != blank %}
                    <div class="sp-meta-item">
                      <span class="sp-meta-label">Brand</span>
                      <span class="sp-meta-value">{{ product.vendor }}</span>
                    </div>
                  {% endif %}
                  {% if product.collections.first %}
                    <div class="sp-meta-item">
                      <span class="sp-meta-label">Collection</span>
                      <span class="sp-meta-value">{{ product.collections.first.title }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  {% endif %}

  {% comment %} Pass 2 — render gallery block below sp-inner {% endcomment %}
  {% for block in section.blocks %}
    {% if block.type == 'gallery' and extra_images.size > 0 %}
      <div class="sp-extra-grid" {{ block.shopify_attributes }}>
        {% for image in extra_images %}
          <div class="sp-extra-frame">
            <img
              src="{{ image | image_url: width: 300, height: 300, crop: 'center' }}"
              alt="{{ image.alt | escape }}"
              width="300"
              height="300"
              loading="lazy"
            >
            <div class="sp-img-shine"></div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --sp-cream: #f9f6f1;
    --sp-sand: #e8e0d5;
    --sp-stone: #b8a99a;
    --sp-dark: #1a1714;
    --sp-charcoal: #3d3530;
    --sp-accent: #8b6f5e;
    --sp-white: #ffffff;
    --sp-radius: 4px;
    --sp-transition: 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ── Wrapper ── */
  .sp-wrap {
    background: var(--sp-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 24px 72px;
    font-family: 'DM Sans', sans-serif;
    gap: 16px;
  }

  /* ── Main container — image left, details right ── */
  .sp-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    max-width: 1280px;
    width: 100%;
    background: var(--sp-white);
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 2px 40px rgba(26, 23, 20, 0.08), 0 0 0 1px rgba(26, 23, 20, 0.04);
  }

  /* ── Main image block ── */
  .sp-gallery {
    background: var(--sp-sand);
    overflow: hidden;
    height: 600px;
  }

  .sp-gallery .sp-img-frame {
    height: 100%;
    width: 100%;
  }

  .sp-img-frame,
  .sp-extra-frame {
    overflow: hidden;
    position: relative;
    background: var(--sp-sand);
  }

  .sp-img-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--sp-transition);
  }

  .sp-img-frame:hover img,
  .sp-extra-frame:hover img {
    transform: scale(1.05);
  }

  .sp-img-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }

  /* ── Details block ── */
  .sp-details {
    border-left: 1px solid var(--sp-sand);
    display: flex;
    flex-direction: column;
    background: var(--sp-white);
  }

  .sp-details-inner {
    padding: 44px 40px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .sp-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .sp-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sp-accent);
    background: rgba(139, 111, 94, 0.1);
    padding: 4px 10px;
    border-radius: 2px;
  }

  .sp-divider-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--sp-stone);
  }

  .sp-sku {
    font-size: 11px;
    color: var(--sp-stone);
    letter-spacing: 0.06em;
  }

  .sp-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 300;
    line-height: 1.15;
    color: var(--sp-dark);
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  .sp-price-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .sp-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 400;
    color: var(--sp-dark);
    letter-spacing: 0.01em;
  }

  .sp-price--sale {
    color: var(--sp-accent);
  }
  .sp-price--compare {
    font-size: 17px;
    color: var(--sp-stone);
    text-decoration: line-through;
  }

  .sp-badge {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sp-white);
    background: var(--sp-dark);
    padding: 4px 10px;
    border-radius: 2px;
  }

  .sp-rule {
    height: 1px;
    background: linear-gradient(to right, var(--sp-sand), transparent);
    margin-bottom: 24px;
  }

  .sp-description {
    font-size: 14px;
    line-height: 1.75;
    color: var(--sp-charcoal);
    opacity: 0.85;
    margin-bottom: 28px;
    flex: 1;
  }

  .sp-form {
    margin-top: auto;
  }

  .sp-actions {
    margin-bottom: 28px;
  }

  .sp-btn-cart {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 15px 28px;
    background: var(--sp-dark);
    color: var(--sp-white);
    border: none;
    border-radius: var(--sp-radius);
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background var(--sp-transition), transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sp-btn-cart:hover {
    background: var(--sp-charcoal);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(26, 23, 20, 0.22);
  }

  .sp-meta {
    display: flex;
    gap: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--sp-sand);
  }

  .sp-meta-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .sp-meta-label {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sp-stone);
    font-weight: 500;
  }
  .sp-meta-value {
    font-size: 13px;
    color: var(--sp-charcoal);
  }

  /* ── Gallery block (thumbnail strip below the main card) ── */
  .sp-extra-grid {
    max-width: 1280px;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 12px;
  }

  .sp-extra-frame {
    width: 200px;
    height: 200px;
    border-radius: 2px;
    border: 1px solid var(--sp-sand);
    cursor: pointer;
    transition: border-color var(--sp-transition);
  }

  .sp-extra-frame:hover {
    border-color: var(--sp-accent);
  }

  .sp-extra-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 1024px) {
    .sp-inner {
      grid-template-columns: 1fr 360px;
    }
    .sp-gallery {
      height: 500px;
    }
  }

  @media screen and (max-width: 768px) {
    .sp-wrap {
      padding: 0 0 56px;
      gap: 16px;
    }

    .sp-inner {
      grid-template-columns: 1fr;
      border-radius: 0;
      box-shadow: none;
    }

    .sp-gallery {
      height: 400px;
    }

    .sp-details {
      border-left: none;
      border-top: 1px solid var(--sp-sand);
    }

    .sp-details-inner {
      padding: 28px 20px;
    }

    .sp-extra-grid {
      padding: 0 20px;
      gap: 8px;
    }

    .sp-extra-frame {
      width: 70px;
      height: 70px;
    }
  }

  @media screen and (max-width: 480px) {
    .sp-gallery {
      height: 320px;
    }
    .sp-extra-frame {
      width: 60px;
      height: 60px;
    }
  }

  .variant-group {
    margin-bottom: 20px;
  }

  .variant-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .variant-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .variant-btn {
    padding: 8px 16px;
    border: 1px solid #dcdcdc;
    background: #fff;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .variant-btn:hover {
    border-color: #000;
  }

  .variant-btn.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .variant-btn.selected {
    background: #000;
    color: #fff;
    border-color: #000;
  }
</style>

{% schema %}
{
  "name": "Single Product Layout",
  "tag": "section",
  "class": "single-product-layout",
  "settings": [
    {
      "type": "range",
      "id": "image_count",
      "label": "Number of Images",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to Cart"
    }
  ],
  "blocks": [
    {
      "type": "main_image",
      "name": "Main Image"
    },
    {
      "type": "details",
      "name": "Details"
    },
    {
      "type": "gallery",
      "name": "Gallery"
    }
  ],
  "presets": [
    {
      "name": "Single Product Layout"
    }
  ]
}
{% endschema %}

<script>
  const product = {{ product | json }};
  let selectedOptions = product.options.map(() => null);

  const variantInput = document.querySelector('input[name="id"]');

  // helper: find matching variant
  function findVariant() {
    return product.variants.find(variant =>
      variant.options.every((opt, index) => opt === selectedOptions[index])
    );
  }

  // update UI (price, hidden input, etc.)
  function updateVariant() {
    const variant = findVariant();
    if (!variant) return;

    // update hidden input for add to cart
    if (variantInput) {
      variantInput.value = variant.id;
    }

    console.log("Selected Variant:", variant);
  }

  // attach click events
  document.querySelectorAll(".variant-group").forEach((group, groupIndex) => {
    const buttons = group.querySelectorAll(".variant-btn");

    buttons.forEach(btn => {
      btn.addEventListener("click", () => {
        const value = btn.innerText.trim();

        // store selected value
        selectedOptions[groupIndex] = value;

        // UI update (selected class)
        buttons.forEach(b => b.classList.remove("selected"));
        btn.classList.add("selected");

        updateVariant();
      });
    });
  });

  // set default selected values (first available variant)
  if (product.variants.length) {
    selectedOptions = [...product.variants[0].options];

    document.querySelectorAll(".variant-group").forEach((group, i) => {
      const value = selectedOptions[i];
      const btn = [...group.querySelectorAll(".variant-btn")]
        .find(b => b.innerText.trim() === value);

      if (btn) btn.classList.add("selected");
    });

    updateVariant();
  }
</script>
