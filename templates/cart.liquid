<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
  }

  .cart-page-wrapper {
    padding: 40px 20px;
  }

  .cart-container {
    max-width: 1200px;
    margin: auto;
    background: #fff;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  .cart-title {
    font-size: 32px;
    margin-bottom: 30px;
  }

  .cart-header-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    padding: 15px 0;
    border-bottom: 2px solid #eee;
    font-weight: bold;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 20px;
    align-items: center;
    padding: 25px 0;
    border-bottom: 1px solid #eee;
  }

  .cart-product-cell {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .cart-img-wrap img {
    width: 100px;
    border-radius: 10px;
  }

  .cart-product-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .item-title {
    text-decoration: none;
    color: #000;
    font-size: 18px;
    font-weight: 600;
  }

  .item-variant {
    color: #666;
    font-size: 14px;
  }

  .item-remove {
    color: red;
    text-decoration: none;
    font-size: 14px;
  }

  .cart-price-cell,
  .cart-qty-cell,
  .cart-total-cell {
    font-size: 16px;
  }

  .qty-selector input {
    width: 80px;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  .cart-summary-block {
    margin-top: 40px;
    display: flex;
    justify-content: flex-end;
  }

  .summary-box {
    width: 350px;
    background: #fafafa;
    padding: 25px;
    border-radius: 10px;
    border: 1px solid #eee;
  }

  .subtotal-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 20px;
    font-weight: bold;
  }

  .shipping-disclaimer {
    color: #666;
    margin-bottom: 25px;
    font-size: 14px;
  }

  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .btn-update-cart,
  .btn-checkout {
    padding: 14px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;
    text-decoration: none;
    text-align: center;
  }

  .btn-update-cart {
    background: #ddd;
  }

  .btn-checkout {
    background: #000;
    color: #fff;
  }

  .empty-cart-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-cart-state p {
    margin-bottom: 20px;
    font-size: 20px;
  }

  .mobile-label {
    display: none;
  }

  @media (max-width: 768px) {
    .cart-header-row {
      display: none;
    }

    .cart-item {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .cart-product-cell {
      flex-direction: column;
      align-items: flex-start;
    }

    .mobile-label {
      display: inline-block;
      font-weight: bold;
      margin-right: 10px;
    }

    .summary-box {
      width: 100%;
    }
  }
</style>

<div class="cart-page-wrapper">
  <div class="cart-container">
    <h1 class="cart-title">Your Shopping Cart</h1>

    {% if cart.item_count > 0 %}
      <form action="/cart" method="post" novalidate class="cart-form">
        <div class="cart-table">
          <div class="cart-header-row">
            <span class="hdr-product">Product</span>
            <span class="hdr-price">Price</span>
            <span class="hdr-qty">Quantity</span>
            <span class="hdr-total">Total</span>
          </div>

          {% for item in cart.items %}
            <div class="cart-item" data-key="{{ item.key }}">
              <div class="cart-product-cell">
                <div class="cart-img-wrap">
                  <img src="{{ item.image | image_url }}" alt="{{ item.title | escape }}">
                </div>

                <div class="cart-product-details">
                  <a href="{{ item.url }}" class="item-title">
                    {{ item.product.title }}
                  </a>

                  {% unless item.product.has_only_default_variant %}
                    <!-- Variant display (clean structured format) -->
                    <div class="item-variant">
                      {% for option in item.product.options %}
                        <div class="variant-line">
                          <strong>{{ option }}:</strong>
                          {{ item.variant.options[forloop.index0] }}
                        </div>
                      {% endfor %}
                    </div>
                  {% endunless %}

                  <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="item-remove"> Remove </a>
                </div>
              </div>

              <div class="cart-price-cell">
                <span class="mobile-label">Price:</span>
                <span>{{ item.price | money }}</span>
              </div>

              <div class="cart-qty-cell">
                <span class="mobile-label">Quantity:</span>

                <div class="qty-selector">
                  <input
                    type="number"
                    name="updates[]"
                    id="updates_{{ item.key }}"
                    value="{{ item.quantity }}"
                    min="0"
                  >
                </div>
              </div>

              <div class="cart-total-cell">
                <span class="mobile-label">Total:</span>
                <span>{{ item.final_line_price | money }}</span>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-summary-block">
          <div class="summary-box">
            <div class="subtotal-row">
              <span>Subtotal:</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <p class="shipping-disclaimer">Taxes and shipping calculated at checkout.</p>

            <div class="cart-actions">
              <button type="submit" name="update" class="btn-update-cart">Update Cart</button>

              <button type="submit" name="checkout" class="btn-checkout">Proceed to Checkout</button>
            </div>
          </div>
        </div>
      </form>

    {% else %}
      <div class="empty-cart-state">
        <p>Your cart is currently empty.</p>

        <a href="/collections/all" class="btn-checkout"> Continue Shopping </a>
      </div>
    {% endif %}
  </div>
</div>
